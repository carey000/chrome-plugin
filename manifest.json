{
  "manifest_version": 3,
  "name": "A无人驾驶",
  "version": "0.0.1",
  "description": "书山有路勤为径，学海无涯自动舟",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "contextMenus",
    "notifications",
    "bookmarks",
    "tabGroups",
    "history"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "action": {
    "default_icon": "assets/icons/icon128.png",
    "default_title": "弹出框",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/unclip-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/unclip-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/config.js",
        "content/core.js",
        "content/sites/kuxueyuan.js",
        "content/sites/baidu.js",
        "content/sites/kaoshibao.js",
        "content/boot.js"
      ],
      "run_at": "document_end"
    }
  ]
}
